# ─────────────────────────────────────────────────────────────
# Rootellect AI OS — environment template. NO real credentials here.
# Copy to .env and fill in. Provider API keys and connector credentials are
# NOT set here: add them in the dashboard (Settings → AI Providers,
# Integrations), where they are encrypted with MASTER_KEY before storage.
# ─────────────────────────────────────────────────────────────

# Control-plane database — Neon Postgres (separate from the rootellect.com storefront DB).
# `neon env pull` writes both of these into .env.local for you.
#   DATABASE_URL           pooled  (host contains "-pooler") → app traffic (Vercel + worker)
#   DATABASE_URL_UNPOOLED  direct  (no "-pooler")           → migrations, pg_dump
# Local alternative without Neon: `npm run db:local` prints URLs for an embedded Postgres.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# 32-byte key, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes stored provider keys/connector credentials unreadable (re-enter them).
MASTER_KEY=""

# Separate secret for signing time-limited approval links and webhook state.
APPROVAL_LINK_SECRET=""

# Public URL of this dashboard (used in approval links and reports).
APP_URL="http://localhost:3100"

# Business defaults
TZ_BUSINESS="Asia/Kolkata"
CURRENCY="INR"

# Where screenshots, traces and generated reports are written.
ARTIFACTS_DIR="./artifacts"

# Worker identity (each worker process should have a unique id).
WORKER_ID="worker-1"

# Simulated AI provider — for tests and demos only. Outputs are labelled SIMULATED
# everywhere. Leave false in real operation.
ALLOW_SIMULATED_PROVIDER="false"

# Vercel Cron authenticates to /api/cron/watchdog with this (Vercel sends it automatically).
CRON_SECRET=""

# Watchdog: emergency out-of-band alert when the worker stops beating.
# Uses the same email/WhatsApp connectors configured in the dashboard.
WATCHDOG_STALE_SECONDS="180"
