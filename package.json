{
  "name": "rootellect-ai-os",
  "version": "0.1.0",
  "private": true,
  "description": "Rootellect AI Operating System — founder-controlled, auditable AI workforce",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "init": "tsx scripts/init-env.ts",
    "setup": "tsx scripts/init-env.ts && prisma generate && prisma migrate deploy && tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "worker": "tsx src/worker/main.ts",
    "watchdog": "tsx src/worker/watchdog.ts",
    "founder:create": "tsx scripts/create-founder.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "qa:browser": "tsx scripts/browser-check.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:acceptance": "vitest run tests/acceptance",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "vercel-build": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts && next build",
    "db:local": "tsx scripts/local-db.ts"
  },
  "dependencies": {
    "@neon/config": "^1.14.5",
    "@neon/env": "^2.1.8",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/functions": "^3.11.3",
    "dotenv": "^18.0.10",
    "next": "^16.4.6",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.7.0-beta.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
